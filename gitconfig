[user]
    email = kareeeeem@gmail.com
    name = Mohammed Kareem
[alias]
    co = checkout
    br = branch
    a = add
    d = diff
    ci = commit
    cam = commit --amend
    st = status
    lg = log --oneline
    lgg = log --oneline --graph
    rb = rebase
    rbi = rebase -i
    ps = push
    pl = pull
[log]
    decorate = auto
[core]
	excludesfile = ~/.gitignore
	attributesfile = ~/.gitattributes
[merge]
	tool = vimdiff
	conflictstyle = diff3
[mergetool]
	prompt = false
[mergetool "vimdiff"]
	trustExitCode = false
	path = nvim
[fetch]
	prune = true
[includeIf "gitdir/i:~/work/"]
    path = ~/.gitconfig-work
[push]
	default = current
[pull]
	default = current
	ff = only
[filter "clean-npmrc"]
	clean = strip-dimension-registry
[init]
	defaultBranch = master
