set -e

json=$(mktemp "${TMPDIR:-/tmp}/${0##*/}.XXXXXX")
cleanup () {
    rm -f "$json"
}
trap cleanup 1 2 3 15

sq_quote () {
    awk -v q="'" '
        BEGIN {
            n = ARGC - 1
            for (i = 1; i <= n; i++) {
                s = ARGV[i]
                gsub(q, q "\\" q q, s)
                printf " %s%s%s", q, s, q
            }
            exit 0
        }
    ' "$@"
}

(
    set -e
    cat >"$json"
    qargs=$(sq_quote "$@")
    query=$(
        FZF_DEFAULT_COMMAND=true \
            fzf --print-query --sync --query=. \
            --preview-window=up,99%,border-none \
            --no-info --no-separator \
            --preview "jq -C {q} $qargs $json || jq -C . $json"
    ) || case $? in 130) exit 130; esac

    echo "jq$(sq_quote "$@" "$query")" >&2
    jq "$@" "$query" "$json"
)
ret=$?
cleanup
exit $ret
